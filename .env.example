# Supabase: Project URL y clave pública para inicio de sesión.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-publica-de-supabase

# Clave service_role: solo servidor. Nunca publicar en variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Crea una aplicación Jamendo API v3 de solo lectura; guarda su Client ID aquí.
JAMENDO_CLIENT_ID=tu-client-id-de-jamendo

# Opcional. Si se configura, protege el endpoint de tareas programadas.
CRON_SECRET=secreto-largo-aleatorio

# Contexto inicial de clima: Ciudad de México. Editar desde configuración.
DEFAULT_LATITUDE=19.4326
DEFAULT_LONGITUDE=-99.1332
DEFAULT_TIMEZONE=America/Mexico_City

# Límites de participación. La huella persistente es un token aleatorio de navegador.
VOTE_RATE_LIMIT_PER_MINUTE=10
